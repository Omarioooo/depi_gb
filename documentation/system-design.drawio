                    <mxGeometry x="1375" y="547" width="280" height="28" as="geometry"/>
                </mxCell>
                <mxCell id="p2-reporting_db-chip-5" value="processed_event &lt;font color=&quot;#9c6b00&quot;&gt;· TBD&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;sketch=1;curveFitting=1;jiggle=2;fillColor=#f5f5f5;strokeColor=#c9a227;fontFamily=Courier New;dashed=1;dashPattern=3 3;fontSize=10;align=left;spacingLeft=6;" vertex="1" parent="1">
                    <mxGeometry x="1675" y="547" width="280" height="28" as="geometry"/>
                </mxCell>
                <mxCell id="p2-rules" value="&lt;b&gt;Ownership rules&lt;/b&gt;&lt;br&gt;• One writer per database — only the owning service connects to it&lt;br&gt;• No cross-database joins and no cross-database foreign keys&lt;br&gt;• Cross-service references are opaque IDs: product_id, supplier_id, user_id&lt;br&gt;• History keeps snapshots (sku, name) so later renames do not rewrite the past&lt;br&gt;• Only Inventory&#39;s idempotency records and outbox are documented; the others are proposed&lt;br&gt;• Consumers must deduplicate by event_id; the storage for that dedup is TBD&lt;br&gt;• Reporting read models are event-fed copies (proposed)" style="rounded=1;whiteSpace=wrap;html=1;sketch=1;curveFitting=1;jiggle=2;fillColor=#fff2cc;strokeColor=#d6b656;align=left;verticalAlign=top;spacing=10;fontSize=10;fillColor=#ffffff;strokeColor=#999999;fontSize=10;" vertex="1" parent="1">
                    <mxGeometry x="60" y="660" width="620" height="230" as="geometry"/>
                </mxCell>
                <mxCell id="p2-refs" value="&lt;b&gt;References, not joins&lt;/b&gt;&lt;br&gt;• product_id → Product Service&lt;br&gt;• supplier_id → Supplier Service&lt;br&gt;• user_id → Keycloak subject claim&lt;br&gt;&lt;br&gt;&lt;b&gt;Foreign keys stay inside one database&lt;/b&gt;&lt;br&gt;• product → category / unit_of_measure&lt;br&gt;• purchase_order → purchase_order_line → goods_receipt_line&lt;br&gt;• alert has no FK to inventory_db; it stores the product_id and a threshold snapshot" style="rounded=1;whiteSpace=wrap;html=1;sketch=1;curveFitting=1;jiggle=2;fillColor=#fff2cc;strokeColor=#d6b656;align=left;verticalAlign=top;spacing=10;fontSize=10;fillColor=#ffffff;strokeColor=#999999;fontSize=10;" vertex="1" parent="1">
                    <mxGeometry x="710" y="660" width="620" height="230" as="geometry"/>
                </mxCell>
                <mxCell id="p2-keycloak" value="" style="rounded=1;whiteSpace=wrap;html=1;sketch=1;curveFitting=1;jiggle=2;fillColor=#fbfbfb;strokeColor=#666666;verticalAlign=top;align=left;fillColor=#f3edf7;strokeColor=#9673a6;" vertex="1" parent="1">
                    <mxGeometry x="1360" y="660" width="620" height="230" as="geometry"/>
                </mxCell>
                <mxCell id="p2-keycloak-icon" value="" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=6;sketch=1;curveFitting=1;jiggle=2;fillColor=#f5f5f5;strokeColor=#666666;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1">
                    <mxGeometry x="1375" y="674" width="34" height="42" as="geometry"/>
                </mxCell>
                <mxCell id="p2-keycloak-header" value="&lt;b&gt;Keycloak database&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px;color:#666666&quot;&gt;Owned by Keycloak · identity schema is not designed here&lt;/font&gt;" style="text;html=1;align=left;verticalAlign=middle;strokeColor=none;fillColor=none;fontFamily=Helvetica;verticalAlign=middle;fontSize=13;" vertex="1" parent="1">
                    <mxGeometry x="1420" y="670" width="530" height="48" as="geometry"/>
                </mxCell>
                <mxCell id="p2-footer" value="No service reads another service&#39;s database. Full columns and cardinalities: .opencode/output/monolithic-erd.drawio." style="text;html=1;align=left;verticalAlign=middle;strokeColor=none;fillColor=none;fontFamily=Helvetica;fontSize=10;fontColor=#666666;" vertex="1" parent="1">
                    <mxGeometry x="60" y="930" width="1700" height="22" as="geometry"/>
                </mxCell>
                <mxCell id="p2-tag-key" value="&lt;b&gt;Tag key&lt;/b&gt; &amp;nbsp; &lt;font color=&quot;#2e6b2e&quot;&gt;● confirmed&lt;/font&gt; — required by the functional requirements &amp;nbsp;&amp;nbsp; &lt;font color=&quot;#1f4e79&quot;&gt;● proposed&lt;/font&gt; — design detail, not approved &amp;nbsp;&amp;nbsp; &lt;font color=&quot;#9c6b00&quot;&gt;● TBD&lt;/font&gt; — not documented anywhere, unresolved" style="text;html=1;align=left;verticalAlign=middle;strokeColor=none;fillColor=none;fontFamily=Helvetica;fontSize=10;" vertex="1" parent="1">
                    <mxGeometry x="60" y="98" width="1700" height="22" as="geometry"/>
                </mxCell>
                <mxCell id="p2-keycloak-note" value="&lt;b&gt;Not a project database&lt;/b&gt;&lt;br&gt;Realm, clients and role mappings are Keycloak configuration.&lt;br&gt;The identity schema belongs to Keycloak and is not designed here — the project only stores the subject claim as &lt;i&gt;user_id&lt;/i&gt;." style="text;html=1;align=left;verticalAlign=top;strokeColor=none;fillColor=none;whiteSpace=wrap;fontFamily=Helvetica;fontSize=10;fontColor=#333333;" vertex="1" parent="1">
                    <mxGeometry x="1420" y="726" width="520" height="90" as="geometry"/>
                </mxCell>
            </root>
        </mxGraphModel>
    </diagram>
</mxfile>