{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "System.Net.Http.HttpClient": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "AuthDb": ""
  },
  "Keycloak": {
    "BaseUrl": "http://localhost:6666",
    "Realm": "auth-realm",
    "ClientId": "auth-client",
    "AdminClientId": "auth-service",
    "AdminTokenRefreshMarginSeconds": 30,
    "Audience": "REPLACE_WITH_ACCESS_TOKEN_AUDIENCE",
    "Issuer": ""
  }
}
