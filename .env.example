# Copy to .env and replace the secrets. .env is ignored by Git.

# --- SQL Server ---
# Do not use double quotes or newlines in the password.
SQLSERVER_HOST_PORT=1433
SQLSERVER_SA_PASSWORD=ChangeMe_Strong!Passw0rd

# --- Databases (created on first start, one per owner) ---
AUTH_DB_NAME=AuthDB
KEYCLOAK_DB_NAME=KeycloakDB
INVENTORY_DB_NAME=InventoryDB

# --- Keycloak ports and URLs (no trailing slash on the public URL) ---
KEYCLOAK_HOST_PORT=6666
KEYCLOAK_MANAGEMENT_HOST_PORT=9000
KEYCLOAK_PUBLIC_URL=http://localhost:6666
KEYCLOAK_INTERNAL_URL=http://keycloak:8080

# --- Keycloak bootstrap administrator (first start only) ---
KEYCLOAK_ADMIN_USERNAME=admin
KEYCLOAK_ADMIN_PASSWORD=ChangeMe_Admin!Passw0rd

# --- Realm and clients (create them manually, see the service README) ---
KEYCLOAK_REALM=auth-realm
KEYCLOAK_CLIENT_ID=auth-client
KEYCLOAK_CLIENT_SECRET=ChangeMe_AuthClientSecret
KEYCLOAK_ADMIN_CLIENT_ID=auth-service
KEYCLOAK_ADMIN_CLIENT_SECRET=ChangeMe_AuthServiceSecret
# Must match the "aud" claim of real Keycloak access tokens.
KEYCLOAK_AUDIENCE=REPLACE_WITH_ACCESS_TOKEN_AUDIENCE

# --- Auth service ---
AUTH_SERVICE_HOST_PORT=5080
